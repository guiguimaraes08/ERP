{
  "entities": {
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Industrial raw materials, 3D spools, lanyards, and parts inventory",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "sku": {
          "type": "string",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "maxLength": 50
        },
        "currentStock": {
          "type": "number"
        },
        "minStock": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "maxLength": 20
        },
        "unitCost": {
          "type": "number"
        },
        "supplier": {
          "type": "string",
          "maxLength": 150
        },
        "location": {
          "type": "string",
          "maxLength": 100
        },
        "leadTimeDays": {
          "type": "number"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "name",
        "sku",
        "category",
        "currentStock",
        "minStock",
        "unit",
        "unitCost",
        "ownerId"
      ]
    },
    "ProductionProject": {
      "title": "ProductionProject",
      "description": "Manufacturing orders, 3D printing jobs, lanyards batch production and cost breakdown",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "code": {
          "type": "string",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "maxLength": 150
        },
        "clientName": {
          "type": "string",
          "maxLength": 150
        },
        "status": {
          "type": "string",
          "maxLength": 50
        },
        "priority": {
          "type": "string",
          "maxLength": 30
        },
        "batchSize": {
          "type": "number"
        },
        "goodParts": {
          "type": "number"
        },
        "rejectedParts": {
          "type": "number"
        },
        "defectReason": {
          "type": "string",
          "maxLength": 200
        },
        "machineType": {
          "type": "string",
          "maxLength": 50
        },
        "estimatedMachineHours": {
          "type": "number"
        },
        "actualMachineHours": {
          "type": "number"
        },
        "laborHours": {
          "type": "number"
        },
        "hourlyLaborRate": {
          "type": "number"
        },
        "hourlyMachineRate": {
          "type": "number"
        },
        "salePrice": {
          "type": "number"
        },
        "deadline": {
          "type": "string",
          "maxLength": 64
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "code",
        "title",
        "clientName",
        "status",
        "batchSize",
        "salePrice",
        "ownerId"
      ]
    }
  },
  "firestore": {
    "/inventory_items/{itemId}": {
      "schema": "InventoryItem",
      "description": "Industrial raw materials and items inventory"
    },
    "/production_projects/{projectId}": {
      "schema": "ProductionProject",
      "description": "Manufacturing production orders and defect metrics"
    }
  }
}
